# Variables públicas: completar antes de compilar para Cloudflare.
# No poner claves ni tokens en variables PUBLIC_.
PUBLIC_KEYSTATIC_GITHUB_REPO=PibeSwitch/webgaps2
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
PUBLIC_SITE_URL=

