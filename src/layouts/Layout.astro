---
import '../styles/global.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import { content, href, type Language, type Page } from '../lib/content';
import settings from '../data/settings.json';
import Channels from '../components/Channels.astro';
import ContactForm from '../components/ContactForm.astro';
import { editorialLabels, publishedLinks } from '../lib/editorial';
interface Props { lang: Language; page: Page; title?: string; description?: string; languageAlternates?: boolean; }
const { lang, page, title, description, languageAlternates = true } = Astro.props;
const d = content[lang];
const es = lang === 'es';
const otherLang = es ? 'en' : 'es';
const labels = es ? { menu: 'Menú', close: 'Cerrar', theme: 'Cambiar a modo oscuro', home: 'Inicio', skip: 'Ir al contenido' } : { menu: 'Menu', close: 'Close', theme: 'Switch to dark mode', home: 'Home', skip: 'Skip to content' };
const nav = [{ page: 'sectors' as const, label: d.nav[0] }, { page: 'specialties' as const, label: d.nav[1] }, { page: 'about' as const, label: d.nav[2] }];
const origin = (import.meta.env.PUBLIC_SITE_URL || 'https://gaps-astro-consultoria-2026.francot13.chatgpt.site').replace(/\/$/, '');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} | GAPS` : d.title}</title>
    <meta name="description" content={description ?? d.description} /><meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title ?? d.title} /><meta property="og:description" content={description ?? d.description} />
    <meta property="og:type" content="website" /><meta property="og:image" content={`${origin}/assets/og-gaps.png`} />
    <meta property="og:locale" content={es ? 'es_AR' : 'en_US'} /><meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={`${origin}${Astro.url.pathname}`} />
    {languageAlternates && <><link rel="alternate" hreflang="es" href={`${origin}${href('es', page)}`} /><link rel="alternate" hreflang="en" href={`${origin}${href('en', page)}`} /></>}
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <script is:inline>
      (() => { let saved; try { saved = localStorage.getItem('gaps-theme'); } catch {} const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches; document.documentElement.dataset.theme = dark ? 'dark' : 'light'; })();
    </script>
  </head>
  <body data-language={lang}>
    <a href="#contenido" class="skip-link">{labels.skip}</a>
    <header class="site-header" id="top">
      <div class="wrap header-inner">
        <a href={href(lang, 'home')} class="brand" aria-label={`GAPS — ${labels.home}`}><img src="/assets/gaps-logo.png" width="430" height="145" alt="GAPS Consultoría y Desarrollos" /></a>
        <nav class="desktop-nav" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
          {nav.map(item => <a href={href(lang, item.page)} aria-current={page === item.page ? 'page' : undefined}>{item.label}</a>)}
          <a href="#contacto" class="nav-contact" data-contact>{d.nav[3]} <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="header-actions">
          <a href={href(otherLang, page)} class="language-link" lang={otherLang} hreflang={otherLang} aria-label={es ? 'English version' : 'Versión en español'}>{otherLang.toUpperCase()}</a>
          <button class="theme-toggle icon-button" type="button" aria-label={labels.theme} title={labels.theme}>
            <svg viewBox="0 0 24 24" class="theme-sun" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"/></svg>
            <svg viewBox="0 0 24 24" class="theme-moon" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14A8.5 8.5 0 0 1 10 3 8.5 8.5 0 1 0 20 14Z"/></svg>
          </button>
          <button class="menu-button" type="button" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>{labels.menu}<span class="menu-bars" aria-hidden="true"></span></button>
        </div>
      </div>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-labelledby="menu-title">
      <div class="menu-top"><span id="menu-title">{labels.menu}</span><button class="icon-button" type="button" data-menu-close aria-label={labels.close}>×</button></div>
      <nav aria-label={es ? 'Navegación móvil' : 'Mobile navigation'}>
        <a href={href(lang, 'home')} aria-current={page === 'home' ? 'page' : undefined}><span>00</span>{labels.home}<span aria-hidden="true">↗</span></a>
        {nav.map((item, i) => <a href={href(lang, item.page)} aria-current={page === item.page ? 'page' : undefined}><span>0{i + 1}</span>{item.label}<span aria-hidden="true">↗</span></a>)}
        <a href="#contacto" data-contact><span>04</span>{d.nav[3]}<span aria-hidden="true">↗</span></a>
      </nav>
      <p class="menu-tagline">{d.hero.title}</p>
      <a class="text-link" href={`mailto:${settings.email}`}>{settings.email}</a>
    </dialog>
    <main id="contenido"><slot /></main>
    <section class="contact-band" id="contacto">
      <div class="wrap contact-grid">
        <div><p class="eyebrow">{d.nav[3]}</p><h2>{d.contact.title}</h2><p>{d.contact.lead}</p><a href={`mailto:${settings.email}`} class="button button-primary" data-contact>{d.hero.cta}<span aria-hidden="true">↗</span></a></div>
        <div class="contact-channels"><Channels lang={lang}/></div>
      </div>
    </section>
    <footer class="site-footer"><div class="wrap footer-grid">
      <div><a class="brand footer-brand" href={href(lang, 'home')}><img src="/assets/gaps-logo.png" alt="GAPS Consultoría y Desarrollos" width="430" height="145" loading="lazy" /></a><p>{d.hero.title}</p></div>
      <nav aria-label={es ? 'Pie de página' : 'Footer'}>{nav.map(item => <a href={href(lang, item.page)}>{item.label}</a>)}{publishedLinks(lang).map(category => <a href={href(lang, category)}>{editorialLabels[lang][category]}</a>)}<a href="#contacto" data-contact>{d.nav[3]}</a></nav>
      <div class="footer-address"><span>{settings.location}</span><a href={settings.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><span>© 2026 GAPS</span></div>
    </div></footer>
    <nav class="mobile-dock" aria-label={es ? 'Accesos rápidos' : 'Quick access'}>
      <a href={href(lang, 'home')} aria-current={page === 'home' ? 'page' : undefined}><span aria-hidden="true">⌂</span>{labels.home}</a>
      <a href={href(lang, 'sectors')} aria-current={page === 'sectors' ? 'page' : undefined}><span aria-hidden="true">▦</span>{d.nav[0]}</a>
      <a href="#contacto" data-contact><span aria-hidden="true">↗</span>{d.nav[3]}</a>
    </nav>
    <dialog class="contact-modal" id="contact-modal" aria-labelledby="contact-dialog-title">
      <div class="contact-modal-header"><div><p class="eyebrow">{d.nav[3]}</p><h2 id="contact-dialog-title">{d.contact.title}</h2></div><button type="button" class="icon-button" data-contact-close aria-label={labels.close}>×</button></div>
      <ContactForm lang={lang} />
      <a class="form-alternative text-link" href={`mailto:${settings.email}`}>{settings.email} ↗</a>
    </dialog>
    <script>import '../scripts/site';</script>
  </body>
</html>
